rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{testId} {
      allow read, write: if true;
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying all user profiles
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // User Interactions (Watch history, loop telemetry, skip events)
      match /interactions/{interactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserInteraction(incoming(), userId);
        allow update: if isOwner(userId) && isValidUserInteraction(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }

    // 2. Track Comments (Publicly readable per track, writeable by author)
    match /tracks/{trackId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidTrackComment(incoming(), trackId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidTrackComment(incoming(), trackId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.id is string &&
        data.id == request.auth.uid &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 50)) &&
        (!('handle' in data) || (data.handle is string && data.handle.size() <= 40)) &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
        (!('ageBadge' in data) || (data.ageBadge is string && data.ageBadge.size() <= 30)) &&
        (!('totalListenTimeSec' in data) || (data.totalListenTimeSec is number && data.totalListenTimeSec >= 0));
    }

    function isValidUserInteraction(data, userId) {
      return data.trackId is string &&
        data.trackId.size() <= 100 &&
        (!('userId' in data) || data.userId == userId) &&
        data.watchDurationSec is number &&
        data.watchDurationSec >= 0 &&
        data.watchDurationSec <= 86400;
    }

    function isValidTrackComment(data, trackId) {
      return data.userId is string &&
        data.userId == request.auth.uid &&
        data.trackId is string &&
        data.trackId == trackId &&
        data.content is string &&
        data.content.size() > 0 &&
        data.content.size() <= 300 &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 50)) &&
        (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 500));
    }
  }
}
